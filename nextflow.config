/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    sceriff0/clinarmonize Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    concept_pack               = 'assets/packs/minimal.yaml'
    stop_after                 = null
    allow_single_dataset       = false
    unseal                     = ''
    locked_model               = 'locked_model.json'
    unseal_log                 = 'unseal.log'

    // Profiling options (§2.1 / §2.2 / §2.3)
    max_unique_listed          = 500
    date_formats                = ['%Y-%m-%d', '%Y-%m', '%Y']
    example_k                  = 5
    na_strings                  = ['', 'NA', 'NULL', '.']
    unit_header_patterns       = 'assets/unit_patterns.yaml'
    ucum_release                = '2.2'
    infer_unit_from_range      = true
    max_failed_frac            = 0.05
    fail_sample_k               = 3

    // Invariant harness options (§10.1). permute_outcome_seed is test-only
    // and unset by default: a normal run permutes nothing.
    permute_outcome_seed       = null
    invariant_n_permutations   = 100
    invariant_scope            = 'propose'

    // Linkage options (§3.1 / §3.2 / §3.3). Every row of the three cards'
    // Params tables, with the card's own default (§11.1). match_threshold
    // and clerical_threshold are in MATCH WEIGHT units -- bits of evidence,
    // log2(m/u) summed over fields -- not probabilities, which is why
    // neither has a 0..1 domain.
    blocking_rules             = 'assets/blocking_rules.yaml'
    max_block_size             = 10000
    max_pairs_warn_frac        = 0.1
    link_em_iterations         = 20
    link_comparison_spec       = 'assets/comparisons.yaml'
    link_u_from_random_pairs   = true
    link_random_pair_n         = 1000000
    match_threshold            = 12.0
    clerical_threshold         = 6.0
    max_collapse_ratio_drop    = 0.5

    // Candidate generation options (§4.1). vocabulary_release is NOT a
    // param here (Ruling R14): the card marks it "pack, required", read
    // from the pack's own `vocabulary` key, never resolved.
    max_candidates_per_column  = 20
    candidate_generators       = ['name_ngram', 'value_set', 'unit']

    // Evidence channel options (§4.2). channel_weights and
    // unit_factor_candidates are the card's Params values verbatim (§11.1);
    // channel_weights' short keys (name/type/card/value/dist/unit) map to
    // the six full channel ids (name_similarity, type_agreement,
    // cardinality, value_overlap, distribution_distance, unit_plausibility)
    // one-to-one, in that same order.
    channel_weights            = [name: 0.15, type: 0.15, card: 0.1, value: 0.3, dist: 0.15, unit: 0.15]
    enabled_channels           = ['name_similarity', 'type_agreement', 'cardinality', 'value_overlap', 'distribution_distance', 'unit_plausibility']
    unit_factor_candidates     = [1, 30.4375, 365.25, 0.001, 1000]
    emit_confirmation_plots    = true

    // Ledger options (§4.3). permute_outcome_seed (§10.1, Task 4) is listed
    // in this card's own Params table too but already exists above --
    // verified to match, left untouched.
    ledger_top_k               = 5
    ledger_float_precision     = 4

    // Confirm options (§5.1). confirmed_ledger stays null by default: the
    // human gate, absent a human. No profile (test included) ever sets a
    // default for it -- the card's own literal Done-when shows -profile
    // test itself refusing without an explicit --confirmed_ledger, and
    // there is no OTHER flag anywhere that can supply a Decision instead.
    confirmed_ledger            = null
    require_rationale           = true
    allow_stale_ledger          = false

    // Rule compiler options (§5.2).
    rule_id_prefix              = 'R-'
    fail_on_rule_collision      = true

    // Map options (§6.1). cdm_domains is the five-table subset the card
    // names; the pipeline never claims full CDM conformance. cdm_version is
    // validated and recorded -- nothing branches on it, and
    // bin/map_concepts.py says so rather than faking a shape difference.
    cdm_version                 = '5.4'
    cdm_domains                 = ['person', 'condition_occurrence', 'drug_exposure', 'measurement', 'observation']
    max_unmapped_frac           = 0.2
    keep_source_concept         = true

    // Unit conversion options (§6.2). unit_conversion_table is the ONLY
    // source of conversions and every row in it is keyed on an analyte:
    // there is no universal mg/dL -> mmol/L factor, so a table keyed on the
    // unit pair alone is wrong for every analyte but one, and wrong in a way
    // nothing downstream can see. plausible_range_quantiles is why a single
    // transcription error cannot fail a run on its own.
    unit_conversion_table       = 'assets/ucum_factors.yaml'
    fail_on_implausible_range   = true
    plausible_range_quantiles   = [0.01, 0.99]

    // Generality audit options (§10.3, Task 11 — not built in this phase).
    // Configured now so the grep, once built, does not inherit a default
    // written before bin/ and subworkflows/ existed (fix round 1, F2).
    generality_terms           = 'assets/forbidden_terms.txt'
    generality_paths           = ['modules/', 'workflows/', 'subworkflows/', 'bin/']

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = 'results'
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    test_data_base                = 'https://raw.githubusercontent.com/OHDSI/EunomiaDatasets/main/datasets'

    // §10.2 fixture options. max_memory is the ceiling conf/test.config
    // projects into process.resourceLimits, so the CI fixture stays
    // runnable on a laptop; snapshot_update is declared here (rather than
    // only as an nf-test CLI flag) so that "were snapshots regenerated on
    // this run?" is a validated, hashable param rather than an invisible
    // property of whoever typed the command.
    max_memory                   = '6.GB'
    snapshot_update              = false
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
    schema_ignore_params       = []
    params_hash_file           = 'results/params_hash.txt'
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load sceriff0/clinarmonize custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load sceriff0/clinarmonize custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/clinicalharmonize.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'sceriff0/clinarmonize'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'clinarmonize',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/sceriff0/clinarmonize'
    description     = """Multi-cohort clinical data harmonization to an OMOP CDM subset"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=26.04.6'
    version         = '0.1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.8.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
    // 2.5.1 -> 2.8.0: the 'validation.defaultIgnoreParams' / 'validation.monochromeLogs'
    // config keys are unchanged, but 2.5.1's ValidationConfig predates the
    // @ConfigOption annotations Nextflow's newer config-schema validator
    // (Nextflow 26.x) checks scopes against, so it warned both as
    // "Unrecognized config option" even though nf-schema honoured them. 2.8.0
    // fixes that at the source; verified clean under `nextflow run . --help`.
}

validation {
    defaultIgnoreParams = (["genomes"] + (params.schema_ignore_params ?: []))
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
