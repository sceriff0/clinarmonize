// §10.1 — the outcome-permutation harness, the invariant's only proof.
//
// Fixtures: tests/fixtures/make_fixtures.py writes an invariant cohort set
// (two cohorts, three datasets) whose tables carry a column named after the
// concept pack's outcome-flagged variable. Run once before this test:
//
//   python3 tests/fixtures/make_fixtures.py
//   nf-test test tests/invariant.nf.test --profile=+docker
//
// The harness writes its report to the path the §10.1 contract names --
// tests/invariant/report.json, under projectDir, NOT under the run's
// outdir -- so these tests read it from $baseDir.
//
nextflow_pipeline {

    name "The outcome-permutation harness"
    script "../main.nf"
    tag "pipeline"
    tag "invariant"

    test("100 permutations of the outcome within each cohort yield exactly one ledger hash") {

        // tests/invariant/report.json is the path the §10.1 contract names,
        // so it lives under projectDir and OUTSIDE $outputDir -- which means
        // nothing clears it between runs. Delete it here, so a green
        // assertion below can only have been produced by THIS run. A test
        // whose pass can be served by a file an earlier invocation left on
        // disk is not measuring this run.
        setup {
            new File("${baseDir}/tests/invariant/report.json").delete()
        }

        when {
            params {
                outdir               = "$outputDir"
                stop_after           = "propose"
                input                = "$baseDir/test_data/fixtures/invariant_samplesheet.csv"
                permute_outcome_seed = "1..100"
                max_failed_frac      = 0.5
            }
        }

        then {
            assert workflow.success

            def report = new groovy.json.JsonSlurper()
                .parse(new File("$baseDir/tests/invariant/report.json"))

            // The card's OUT slot, verbatim: {n_permutations, n_distinct_hashes}.
            // n_permutations counts the replicates the run was OBSERVED to
            // permute, not the seeds it was asked for, so this cannot be
            // satisfied by the CLI string alone.
            assert report.n_permutations == 100
            assert report.n_seeds_requested == 100

            // Every cohort was permuted in EVERY replicate, and every
            // permuted column carried its input column's multiset. Without
            // these, "one hash across 100 replicates" could be one hash
            // across 99 replicates nothing ever happened to.
            assert report.cohorts_without_outcome_column == []
            assert report.cohorts_with_incomplete_replicates == [:]
            assert report.marginal_moved == []
            assert report.no_op_permutations == []

            // The assertion itself: len(set(hashes)) == 1. Not "mostly agree"
            // (§10.1 nogo) -- one hash, or this is a schema-level leak.
            assert report.n_distinct_hashes == 1

            // A run that never produced a ledger has n_distinct_hashes == 0,
            // which is not 1 and so already fails above -- but assert the
            // verdict too, so the failure message names WHY rather than
            // leaving a bare 0 != 1 to be interpreted.
            assert report.verdict == "proof"

            // Fix round 1 (Important #1): verdict: 'no-ledger' only fires on
            // ZERO hashes -- 101 replicates of an EMPTY ledger.proposed.yaml
            // would hash identically too and still report 'proof'. Today's
            // non-emptiness rests on a coincidence between the invariant
            // fixture's columns and assets/packs/minimal.yaml's variables
            // that no earlier assertion here defended; read the published
            // baseline ledger directly and require at least one real
            // proposal, so changing either the fixture or the pack in a way
            // that empties the ledger fails HERE, loudly, instead of leaving
            // this the headline gate a silent tautology.
            def ledger = new org.yaml.snakeyaml.Yaml().load(new File("$outputDir/ledger.proposed.yaml").text) as List
            assert ledger.size() > 0
            def allProposals = ledger.collectMany { it.proposals }
            assert allProposals.size() > 0
            assert allProposals.every { it.variable != null && it.total != null }
        }
    }

    test("the permutation preserves each cohort's outcome marginal and changes only its pairing") {

        // tests/invariant/report.json is the path the §10.1 contract names,
        // so it lives under projectDir and OUTSIDE $outputDir -- which means
        // nothing clears it between runs. Delete it here, so a green
        // assertion below can only have been produced by THIS run. A test
        // whose pass can be served by a file an earlier invocation left on
        // disk is not measuring this run.
        setup {
            new File("${baseDir}/tests/invariant/report.json").delete()
        }

        when {
            params {
                outdir               = "$outputDir"
                stop_after           = "profile"
                input                = "$baseDir/test_data/fixtures/invariant_samplesheet.csv"
                permute_outcome_seed = "1..3"
                max_failed_frac      = 0.5
            }
        }

        then {
            assert workflow.success

            def report = new groovy.json.JsonSlurper()
                .parse(new File("$baseDir/tests/invariant/report.json"))

            def records = report.permutations as List
            assert records.size() > 0

            // Every cohort in the sheet contributed at least one permuted
            // column. A cohort set where nothing matched would make this
            // whole test vacuous, which is the failure mode §10.1's nogo is
            // guarding against.
            assert report.cohorts_without_outcome_column == []

            // Every replicate permuted every cohort. Coverage summed across
            // replicates would let one permuted replicate vouch for the rest.
            assert report.cohorts_with_incomplete_replicates == [:]
            assert report.n_permutations == 3

            records.groupBy { [it.cohort_id, it.dataset_id, it.column] }.each { key, group ->
                assert group.size() == 3  // one record per seed

                // §10.1 Trap: permuting WITHIN each cohort preserves that
                // cohort's outcome marginal. marginal_sha256 is hashed from
                // the column as WRITTEN to the permuted CSV and
                // baseline_marginal_sha256 from the column as READ from the
                // input table, so this compares two independently produced
                // multisets. (Comparing a shuffle's own output against
                // itself is the identity sorted(perm(X)) == sorted(X) and
                // can never fail; that guard would prove nothing.)
                group.each { record ->
                    assert record.baseline_marginal_sha256 != null
                    assert record.marginal_sha256 == record.baseline_marginal_sha256
                }
                assert report.marginal_moved == []

                // ...and the permutation is real: the row-ORDER pairing
                // differs between seeds. A no-op "permutation" would leave
                // both hashes constant and prove nothing, which the report
                // now refuses to certify as well.
                assert group*.ordered_sha256.toSet().size() > 1
                assert report.no_op_permutations == []
            }
        }
    }

    test("a cohort set with no column matching the pack's outcome variable is refused, not silently proved") {

        // tests/invariant/report.json is the path the §10.1 contract names,
        // so it lives under projectDir and OUTSIDE $outputDir -- which means
        // nothing clears it between runs. Delete it here, so a green
        // assertion below can only have been produced by THIS run. A test
        // whose pass can be served by a file an earlier invocation left on
        // disk is not measuring this run.
        setup {
            new File("${baseDir}/tests/invariant/report.json").delete()
        }

        when {
            params {
                outdir               = "$outputDir"
                stop_after           = "profile"
                input                = "$baseDir/test_data/fixtures/no_outcome_samplesheet.csv"
                permute_outcome_seed = "1..2"
                max_failed_frac      = 0.5
            }
        }

        then {
            assert workflow.success

            def report = new groovy.json.JsonSlurper()
                .parse(new File("$baseDir/tests/invariant/report.json"))

            // Nothing was permuted, so no permutation happened, so no hash
            // agreement means anything. The harness must say so rather than
            // report a clean run -- "0 distinct hashes, all seeds agree" is
            // exactly the switched-off gate the card's Trap describes.
            assert report.cohorts_without_outcome_column == ["COHORT_NO_OUTCOME"]
            assert report.verdict == "no-outcome-column"
            assert report.permutations == []

            // Nothing was permuted, so the observed permutation count is
            // zero even though two seeds were requested. Reporting the
            // requested count here would let a run that permuted nothing
            // claim it permuted two.
            assert report.n_permutations == 0
            assert report.n_seeds_requested == 2
        }
    }

    test("--invariant_scope map holds the claim over mapped/ as well as the ledger, and both stay put under permutation (ADR-004)") {

        // ADR-004: §6.1 joins link/links.parquet for person_id -- a statistic
        // computed jointly across records, and the first value to reach a
        // published artefact without passing through ledger.proposed.yaml.
        // This scope is the COMPOSITION of the propose scope with that edge,
        // so both artefacts are hashed and both must be single-valued.
        //
        // A HUNDRED replicates, the same count the first test of this file
        // holds the proposer to. A map-scoped replicate re-runs profile ->
        // link -> map on the permuted bytes, so this is ~1120 tasks against
        // the propose scope's ~400 -- measured at 345s locally against 227s,
        // which is a cost worth paying rather than a reason to shorten the
        // range. bin/invariant_report.py names 'insufficient-permutations' as
        // its own verdict precisely because shortening the range is the
        // cheapest way to weaken this test, and a map scope certified on ten
        // seeds beside a propose scope certified on a hundred would be a
        // weaker claim wearing the same word, 'proof'.
        setup {
            new File("${baseDir}/tests/invariant/report.json").delete()
        }

        when {
            params {
                outdir                   = "$outputDir"
                stop_after               = "map"
                invariant_scope          = "map"
                input                    = "$baseDir/test_data/fixtures/invariant_samplesheet.csv"
                // The human gate. §5 is never re-run per replicate (it cannot
                // be -- a permuted replicate's proposed ledger would fail
                // CONFIRM_LEDGER's staleness check, correctly), so every
                // replicate maps against the rules confirmed HERE, once,
                // against the baseline.
                confirmed_ledger         = "$baseDir/test_data/fixtures/confirm_ledger_invariant.yaml"
                // The link fixture's own rule files. The invariant cohort set
                // carries the same five identity fields precisely so these
                // apply unchanged -- see make_fixtures.py's own note on why a
                // second, re-cased copy would be two rule sets to keep in step.
                blocking_rules           = "$baseDir/test_data/fixtures/link_blocking_rules.yaml"
                link_comparison_spec     = "$baseDir/test_data/fixtures/link_comparisons.yaml"
                permute_outcome_seed     = "1..100"
                // Left at the pipeline default (100) rather than lowered to
                // match: this run genuinely permutes a hundred times.
                invariant_n_permutations = 100
                // Most of this fixture's columns are identity fields that make
                // §3 do real work and are not in assets/packs/minimal.yaml, so
                // ~0.8 of its source values are unmapped BY CONSTRUCTION. The
                // gate itself is tested on its own terms in
                // tests/map_concepts.nf.test; raising it here is about letting
                // this run reach the mapper at all.
                max_unmapped_frac        = 0.9
                max_failed_frac          = 0.5
            }
        }

        then {
            assert workflow.success

            def report = new groovy.json.JsonSlurper()
                .parse(new File("$baseDir/tests/invariant/report.json"))

            assertAll(
                {
                    // The scope really was 'map', and the report says what it
                    // held its claim over rather than leaving a reader to
                    // infer it from a version of this file.
                    assert report.scope == "map"
                    assert report.scope_artefacts == ["ledger.proposed.yaml", "mapped/"]
                },
                {
                    // The harness ran for real: every cohort permuted in every
                    // replicate, every marginal preserved, no seed a no-op.
                    assert report.n_permutations == 100
                    assert report.n_seeds_requested == 100
                    assert report.cohorts_without_outcome_column == []
                    assert report.cohorts_with_incomplete_replicates == [:]
                    assert report.marginal_moved == []
                    assert report.no_op_permutations == []
                },
                {
                    // Both artefacts exist for the BASELINE and for every
                    // seed. 'null' is the baseline's key, and it is required:
                    // replicates that agree with each other but not with the
                    // run on the real data have shown the leak was
                    // deterministic, not that there was none.
                    assert report.missing_ledgers == []
                    assert report.missing_mapped == []
                    assert report.mapped_hashes.size() == 101
                    assert report.mapped_hashes.containsKey("null")
                },
                {
                    // The assertion itself, per artefact and composed.
                    assert report.n_distinct_hashes_per_artefact.ledger == 1
                    assert report.n_distinct_hashes_per_artefact.mapped == 1
                    assert report.n_distinct_hashes == 1
                    assert report.verdict == "proof"
                },
                {
                    // NON-VACUITY 1: linkage actually linked. person_id cannot
                    // be a function of the outcome if no linkage decision was
                    // ever made -- a fixture of singleton clusters would go
                    // green here while measuring nothing, which is the same
                    // family of vacuity as the 'no-op-permutation' verdict.
                    def linkReport = new groovy.json.JsonSlurper()
                        .parse(new File("$outputDir/link/link_report.json"))
                    assert linkReport.n_linked_pairs > 0 :
                        "no pair was linked, so no person_id is a cluster and the §3 -> §6 edge is untested"
                    assert linkReport.n_persons < linkReport.n_in :
                        "every record is its own person, so linkage decided nothing"
                },
                {
                    // NON-VACUITY 2: the mapped artefact has content. An empty
                    // mapped/ would hash identically across every replicate
                    // and report 'proof' -- 'no distinct hashes' and 'one
                    // distinct hash' must not be the same observation.
                    def read = { path ->
                        def proc = ['python3', "${projectDir}/tests/fixtures/read_mapped.py", path].execute()
                        def out = new StringBuilder(), err = new StringBuilder()
                        proc.waitForProcessOutput(out, err)
                        assert proc.exitValue() == 0 : "could not read ${path}: ${err}"
                        new groovy.json.JsonSlurper().parseText(out.toString())
                    }
                    def person = read("$outputDir/mapped/person.parquet")
                    assert person.rows.size() > 0
                    assert person.rows.every { it.person_id != null }

                    // NON-VACUITY 3: the OUTCOME column's values are inside
                    // the digested artefact. §4.1 never proposes an
                    // outcome-flagged column, so TIME_TO_EVENT has no rule and
                    // its values land in _unmapped.parquet -- which ADR-004
                    // puts inside the digest precisely so that a leak moving a
                    // value between a domain table and the unmapped set cannot
                    // be invisible. If they were absent, the permutation would
                    // have nothing to move in the thing being hashed.
                    def unmapped = read("$outputDir/mapped/_unmapped.parquet")
                    assert unmapped.rows*.column.toSet().contains('TIME_TO_EVENT') :
                        "the permuted column's values never reach mapped/, so the digest cannot see them move"
                }
            )
        }
    }

    test("a map-scoped run that stops SHORT of map is reported as unmeasured, never as a proof") {

        // The mirror of the scope-OVERRUN refusal below. Overrun is refused
        // outright, because the later stages would run and publish under a
        // verdict that never measured them. Stopping short is different: it
        // is a legitimate thing to ask for (the propose half of the scope
        // still runs, and its numbers are real), and the danger is only that
        // the run might be READ as a proof of the whole scope. So the report
        // names it instead -- 'no-mapped-artefact', with the missing
        // replicates listed -- and the verdict is not 'proof'.
        //
        // Refusing this at the gate instead would also have made the existing
        // '--stop_after profile' tests above illegal, and those measure the
        // permutation mechanics rather than any proof.
        setup {
            new File("${baseDir}/tests/invariant/report.json").delete()
        }

        when {
            params {
                outdir                   = "$outputDir"
                stop_after               = "propose"
                invariant_scope          = "map"
                input                    = "$baseDir/test_data/fixtures/invariant_samplesheet.csv"
                permute_outcome_seed     = "1..10"
                invariant_n_permutations = 10
                max_failed_frac          = 0.5
            }
        }

        then {
            assert workflow.success

            def report = new groovy.json.JsonSlurper()
                .parse(new File("$baseDir/tests/invariant/report.json"))

            assertAll(
                {
                    assert report.scope == "map"
                    assert report.verdict == "no-mapped-artefact"
                    assert report.verdict != "proof"
                },
                {
                    // The ledger half genuinely ran and genuinely agreed --
                    // which is exactly why the verdict has to come from the
                    // MISSING half. A report that folded the two together
                    // would show one distinct hash and read as a pass.
                    assert report.missing_ledgers == []
                    assert report.n_distinct_hashes_per_artefact.ledger == 1
                    assert report.missing_mapped.size() == 11
                    assert report.mapped_hashes == [:]
                }
            )
        }
    }

    test("the harness's stage-gate exemption covers only its own scope, not every later stage") {
        // The exemption exists because the harness's measurement IS which
        // contract output the unbuilt proposer failed to produce, so
        // --stop_after propose (== invariant_scope) must be allowed through.
        // It is bound to that stage and nothing else: a seeded run aimed
        // past it stays refused, so `--permute_outcome_seed 1..100
        // --stop_after map` cannot report [SUCCESS] with the mapper never
        // having been measured.
        //
        // Until §6.1 this test passed for an INCIDENTAL reason -- 'map' was
        // unimplemented, so the stage gate refused it on the way past, and
        // the property this test is named for was never actually exercised.
        // Building §6.1 made 'map' implemented and the run sailed through,
        // which is how the gap was found. workflows/harmonize.nf now refuses
        // scope-overrun explicitly, so the assertion below is about the real
        // mechanism and no longer moves when a stage lands.

        when {
            params {
                outdir               = "$outputDir"
                stop_after           = "map"
                input                = "$baseDir/test_data/fixtures/invariant_samplesheet.csv"
                permute_outcome_seed = "1..2"
                max_failed_frac      = 0.5
            }
        }

        then {
            assert !workflow.success
            def stderr = (workflow.stdout + workflow.stderr).join('\n')

            // Refused for the RIGHT reason: the scope, not the build state.
            // 'map' is implemented as of §6.1, so a message about an
            // unimplemented stage here would mean the check had silently
            // reverted to the incidental one.
            assert stderr.contains('runs PAST')
            assert stderr.contains('invariant_scope')
            assert !stderr.contains('not implemented')

            // And refused BEFORE anything ran. A refusal that arrives after
            // the mapper has already published mapped/ is not a refusal.
            assert workflow.trace.tasks().size() == 0
        }
    }
}
