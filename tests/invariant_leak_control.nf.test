// §10.1 — the negative control: does the harness actually go RED when the
// outcome column genuinely leaks into a channel?
//
// docs/steps/s10-1.md's own done-when has TWO clauses:
//   "100 permutations yield one hash; deliberately wiring the outcome into
//    a channel makes the test fail."
// tests/invariant.nf.test only ever demonstrates the first. This file
// demonstrates the second -- the harness's SENSITIVITY, not just its
// specificity. Without this, "the gate is on" was argued from code reading,
// never observed.
//
// Mechanism, fix round 2 (a real source file was never a safe place to do
// this -- see below): setup{} copies the small subset of the real project a
// plain `nextflow run` needs (main.nf, nextflow.config, nextflow_schema.json,
// conf/, modules/, subworkflows/, workflows/, bin/, assets/ -- never tests/,
// test_data/, .git, or any nf-test scaffolding) into a scratch directory
// (.leak_control_copy/, gitignored), sabotages ONLY the COPY's
// bin/propose_channels.py (monkeypatches EvidenceChannel_score so every
// channel's score is REPLACED by a hash of the profile belonging to
// whichever column's name matches an outcome-flagged pack variable -- the
// outcome column's own profile bytes, in ROW ORDER, which PERMUTE_OUTCOME
// shuffles per seed), and points this ONE test's `script` at the copy's
// main.nf instead of the real one. cleanup{} deletes the whole scratch
// directory.
//
// The real checkout (bin/propose_channels.py included) is NEVER opened for
// writing by this test, at any point, under any outcome. Fix round 1's
// construction (sabotage bin/propose_channels.py in place, restore it in
// cleanup{}) was reviewed and found to have four live hazards -- a setup{}
// exception before the original text was captured would leave cleanup{}
// truncating the file to zero bytes; the restore round-tripped through
// file.text, which is charset-mediated and the file carries 22 non-ASCII
// '§' lines; the restore was never verified byte-for-byte; and a SIGKILL
// mid-test left no recovery path. None of those hazards can occur here,
// because there is nothing tracked left in a half-written state: the ONLY
// thing ever written to is a gitignored scratch copy, deleted (or, on a
// crash, simply overwritten by copyRoot.deleteDir() at the TOP of the next
// setup{}) after use, and the real bin/propose_channels.py is opened
// read-only exactly once, to seed the copy.
//
// A production "leak mode" toggle was deliberately NOT added: nothing in
// the real bin/, modules/, workflows/ or the schema ever changes; a plain
// `nextflow run .` always uses the real, unmodified pipeline -- the
// sabotaged code exists only inside a directory this one test creates and
// destroys.

nextflow_pipeline {

    name "The outcome-permutation harness's negative control"
    // A STATIC relative path, resolved by nf-test/Nextflow exactly like
    // "../main.nf" is everywhere else in this suite (relative to this test
    // file's own directory) -- NOT computed at parse time, so no baseDir/
    // projectDir lookup is needed here. setup{} (below) is responsible for
    // making sure this path exists and carries the sabotaged copy before
    // `when{}` ever triggers Nextflow.
    script "../.leak_control_copy/main.nf"
    tag "pipeline"
    tag "invariant"

    test("deliberately wiring the outcome column's profile into every channel's score makes the harness report a leak, not a proof") {

        def copyRoot

        setup {
            copyRoot = new File("${baseDir}/.leak_control_copy")
            // A stale copy from a killed prior run (fix round 2, hazard 4)
            // is cleaned up here rather than trusted to cleanup{} below --
            // belt and suspenders, and it costs nothing since this whole
            // directory is gitignored and disposable either way. This also
            // takes care of any stale tests/invariant/report.json INSIDE
            // the copy (see the note on INVARIANT_REPORT's publishDir
            // below) -- there is no separate file to delete up front.
            if (copyRoot.exists()) {
                copyRoot.deleteDir()
            }
            copyRoot.mkdirs()

            // A JVM-level safety net for the SIGKILL case cleanup{} cannot
            // reach: even if this process is killed mid-test, the NEXT run's
            // setup{} above still starts clean, and this hook gives the
            // current run its own best-effort chance too. Harmless no-op
            // once cleanup{} has already deleted copyRoot.
            Runtime.getRuntime().addShutdownHook(new Thread({
                if (copyRoot.exists()) {
                    copyRoot.deleteDir()
                }
            }))

            ['main.nf', 'nextflow.config', 'nextflow_schema.json', 'conf', 'modules', 'subworkflows', 'workflows', 'bin', 'assets'].each { name ->
                def src = new File("${baseDir}/${name}")
                def proc = ['cp', '-R', src.absolutePath, copyRoot.absolutePath].execute()
                proc.waitFor()
                if (proc.exitValue() != 0) {
                    throw new RuntimeException("failed to copy '${name}' into the leak-control sandbox: ${proc.err.text}")
                }
            }

            // Sabotage the COPY only. The real bin/propose_channels.py is
            // read here (via the copy, itself just read from the real file
            // one line above) and never opened for writing at any point in
            // this test.
            def proposeChannelsFile = new File(copyRoot, 'bin/propose_channels.py')
            def originalText = proposeChannelsFile.text
            def marker = 'if __name__ == "__main__":'
            assert originalText.contains(marker) : 'bin/propose_channels.py no longer carries the expected anchor line -- update this test\'s insertion point.'

            def sabotage = '''
# ============================================================================
# TEST-ONLY NEGATIVE CONTROL -- tests/invariant_leak_control.nf.test
# Lives ONLY in the gitignored .leak_control_copy/ scratch tree this one
# test creates and destroys. Never present in the real bin/, never
# reachable from a normal `nextflow run .`.
#
# Monkeypatches EvidenceChannel_score so every channel's score becomes a
# function of the outcome-flagged variable's own column profile (found by
# the SAME normalised-name match score_name_similarity uses). PERMUTE_OUTCOME
# shuffles that column's row order per seed, so this hash -- and therefore
# every ledger byte -- becomes a genuine function of the outcome column.
# ============================================================================
import glob as _sabotage_glob
import hashlib as _sabotage_hashlib


def _sabotage_argv_value(flag):
    argv = sys.argv
    for i, a in enumerate(argv):
        if a == flag and i + 1 < len(argv):
            return argv[i + 1]
    return None


def _sabotage_outcome_hash():
    profile_glob = _sabotage_argv_value("--profile-glob")
    pack_variables_arg = _sabotage_argv_value("--pack-variables")
    if not profile_glob or not pack_variables_arg:
        return None
    variables = json.loads(pack_variables_arg)
    outcome_names = {_normalize_name(v["name"]) for v in variables if v.get("outcome")}
    if not outcome_names:
        return None
    for path in sorted(_sabotage_glob.glob(profile_glob)):
        with open(path, encoding="utf-8") as fh:
            profiles = json.load(fh)
        for p in profiles:
            if _normalize_name(p["column"]) in outcome_names:
                blob = json.dumps(p, sort_keys=True).encode("utf-8")
                return int(_sabotage_hashlib.sha256(blob).hexdigest(), 16)
    return None


_SABOTAGE_OUTCOME_HASH = _sabotage_outcome_hash()
_SABOTAGE_ORIGINAL_SCORE = EvidenceChannel_score


def EvidenceChannel_score(channel_id, column_profile, variable, params):
    score, detail = _SABOTAGE_ORIGINAL_SCORE(channel_id, column_profile, variable, params)
    if score is not None and _SABOTAGE_OUTCOME_HASH is not None:
        # REPLACE, not perturb-and-clamp: several of this fixture's channels
        # (exact normalised name matches, matching declared types) already
        # score a real 1.0 before sabotage, so an additive perturbation
        # clamped to [0, 1] gets silently absorbed at the ceiling and every
        # replicate looks identical again -- a false negative discovered
        # empirically (fix round 1's first attempt: n_distinct_hashes stayed
        # 1). Replacing the score outright with a value drawn from the
        # outcome profile's own hash cannot be absorbed this way.
        score = (_SABOTAGE_OUTCOME_HASH % 10000) / 10000.0
        detail = dict(detail)
        detail["_test_only_sabotage"] = "score replaced by a hash of the outcome column's own profile (negative control)"
    return score, detail
# ============================================================================
# END TEST-ONLY NEGATIVE CONTROL
# ============================================================================

'''

            proposeChannelsFile.text = originalText.replace(marker, sabotage + marker)
        }

        when {
            params {
                outdir                    = "$outputDir"
                stop_after                = "propose"
                input                     = "$baseDir/test_data/fixtures/invariant_samplesheet.csv"
                permute_outcome_seed      = "1..10"
                // Matches the seed count above (the schema's own minimum for
                // invariant_n_permutations -- §11.1 -- is 10): this control
                // only needs to observe a hash split, not reproduce the full
                // 100-seed CI claim (that is tests/invariant.nf.test's job).
                // Left at the default 100, n_permutations(10) < n_required(100)
                // would report 'insufficient-permutations' before ever
                // reaching the hash-count branch, hiding the very thing this
                // test exists to observe.
                invariant_n_permutations = 10
                max_failed_frac          = 0.5
            }
        }

        then {
            // The run itself must still SUCCEED -- the sabotage perturbs
            // scores, it does not corrupt evidence.parquet's schema or crash
            // any process. A workflow failure here would be a different bug,
            // not the leak this test is built to observe.
            assert workflow.success

            // conf/modules.config pins INVARIANT_REPORT's publishDir to
            // "${projectDir}/tests/invariant" -- deliberately outside
            // params.outdir (see that file's own comment) -- and `projectDir`
            // is the RUNNING script's own directory. Since this test's
            // `script` points at the sandbox copy, `projectDir` for this one
            // run is copyRoot, not the real repo; the report lands at
            // copyRoot/tests/invariant/report.json, never touching the real
            // repo's tests/invariant/ at all (which tests/invariant.nf.test,
            // running against the real script, still owns exclusively).
            def report = new groovy.json.JsonSlurper()
                .parse(new File(copyRoot, 'tests/invariant/report.json'))

            // The harness ran for real: every replicate covered, no
            // no-op/incomplete/marginal-moved confound that would make a
            // hash split (or agreement) mean nothing.
            assert report.n_permutations == 10
            assert report.cohorts_without_outcome_column == []
            assert report.cohorts_with_incomplete_replicates == [:]
            assert report.marginal_moved == []
            assert report.no_op_permutations == []

            // The actual negative-control assertion: a real, deliberate
            // dependency on the outcome column produces MORE than one
            // distinct ledger hash across replicates, and the harness names
            // it 'leak', not 'proof' -- s10-1's second done-when clause,
            // observed for the first time in this repo.
            assert report.n_distinct_hashes > 1
            assert report.verdict == 'leak'
        }

        cleanup {
            if (copyRoot?.exists()) {
                copyRoot.deleteDir()
            }
        }
    }
}
