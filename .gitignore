# §10.1 harness output -- a per-run measurement, regenerated by
# `nf-test test tests/invariant.nf.test`, never reviewed as source.
tests/invariant/

# tests/invariant_leak_control.nf.test's disposable sabotage sandbox --
# never committed, deleted by the test's own cleanup{}.
.leak_control_copy/

# Verification runs from tools/verify_clinarmonize.sh. Per-run evidence, not
# source: the tarball bundles an overlay venv (~24MB) and the logs carry
# absolute cluster paths and usernames. Attach these to an issue if they are
# needed for review; never commit them.
verification-*/
clinarmonize-verification-*.tar.gz

# SLURM's own stdout/stderr for tools/verify_clinarmonize.sh. #SBATCH --output
# writes logs/clinarmonize_verify_%j.out at job start -- before the script's
# first line runs, and therefore before its own `git dirty` check. Untracked
# files here are why every cluster run reported "git dirty: yes", which
# detaches the reported commit from the code it is supposed to identify.
logs/
