/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run clinarmonize/clinicalharmonize -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // nf-core/test-datasets has no OMOP branch (Ruling R6): test data comes
    // from OHDSI/EunomiaDatasets instead, fetched at runtime into a
    // gitignored test_data/ by tests/fixtures/fetch_eunomia.py (run it once
    // before `nextflow run . -profile test,docker ...`; nf-schema validates
    // params.input's paths before any process runs, so they must already
    // exist on disk by then).
    test_data_base = 'https://raw.githubusercontent.com/OHDSI/EunomiaDatasets/main/datasets'
    input           = "${projectDir}/test_data/samplesheet.csv"
}
