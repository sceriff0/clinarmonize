/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run clinarmonize/clinicalharmonize -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // §10.2 Params: the ceiling that keeps this fixture runnable on a
    // laptop and in CI. Declared here (set by profile, per the card) and
    // projected into process.resourceLimits below, so there is exactly one
    // number and --help shows it -- a bare '15.GB' inside resourceLimits
    // was a magic number in the §11.1 sense: invisible to --help,
    // unvalidated, and absent from the params hash.
    max_memory = '6.GB'

    // nf-core/test-datasets has no OMOP branch (Ruling R6): test data comes
    // from OHDSI/EunomiaDatasets instead, fetched at runtime into a
    // gitignored test_data/ by tests/fixtures/fetch_eunomia.py (run it once
    // before `nextflow run . -profile test,docker ...`; nf-schema validates
    // params.input's paths before any process runs, so they must already
    // exist on disk by then).
    test_data_base = 'https://raw.githubusercontent.com/OHDSI/EunomiaDatasets/main/datasets'
    input           = "${projectDir}/test_data/samplesheet.csv"

    // §10.2 -- the pack half of the fixture. assets/packs/minimal.yaml (the
    // schema default) declares age_at_index / sex / vital_status, which
    // share no trigram or value-set overlap with OMOP CDM 5.3's column
    // headers, so this profile produced 35 candidate rows, ZERO distinct
    // variables, and an empty ledger.proposed.yaml. Correct behaviour
    // (§4.1's SIDE clause) and a useless acceptance run: it proved the
    // pipeline ran and never that it mapped. assets/packs/omop_cdm53.yaml
    // is the OMOP-shaped pack that makes the default run produce real
    // proposals; its header comment states, at length, why that does NOT
    // make Eunomia a sufficient fixture on its own (§10.2's Trap) and why
    // -profile test_full exists.
    concept_pack   = "${projectDir}/assets/packs/omop_cdm53.yaml"
}

process {
    // cpus/time are fixture-runner limits with no §10.2 params row; memory
    // is params.max_memory, so the one number a reader can find in --help
    // is the one the run actually applies (§11.1's Trap: a schema default
    // differing from the applied default is a defect).
    resourceLimits = [
        cpus: 4,
        memory: params.max_memory,
        time: '1.h'
    ]
}
