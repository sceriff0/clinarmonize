/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    §10.2's second fixture: MIMIC-IV demo v2.2, run nightly.

    Use as follows:
        python3 tests/fixtures/fetch_mimic_demo.py
        nextflow run clinarmonize/clinicalharmonize -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'MIMIC-IV demo v2.2 — the messy fixture (§10.2)'

    // Same ceiling as -profile test, and for the same reason: §10.2's own
    // Params row says max_memory "keeps -profile test runnable on a laptop
    // and in CI". The demo subset is a few hundred KB per table, so there
    // is nothing here that needs more; a nightly that only runs on a large
    // machine is a nightly nobody can reproduce when it goes red.
    max_memory = '6.GB'

    // MIMIC-IV demo is the OPEN-ACCESS subset (ODC-BY, no PhysioNet
    // credentialing) — which is why §10.2's Alternatives table names the
    // demo and rejects full MIMIC-IV: "credentialed access, so CI cannot
    // run it and the fixture stops being public".
    //
    // Fetched at runtime into a gitignored test_data/ by
    // tests/fixtures/fetch_mimic_demo.py, never committed (§10.2 nogo),
    // and fetched BEFORE the run: nf-schema validates params.input's paths
    // synchronously at pipeline start, so the tables must exist on disk by
    // then and cannot be fetched by a Nextflow process. Same constraint,
    // same shape, as conf/test.config's Eunomia fetch.
    test_data_base = 'https://physionet.org/files/mimic-iv-demo/2.2'
    input          = "${projectDir}/test_data/samplesheet_mimic.csv"

    // The pack half of the fixture. NOT omop_cdm53.yaml: that pack's names
    // are OMOP column headers, and matching OMOP names to OMOP columns is
    // the easy case §10.2's Trap warns is not a test. clinical_core.yaml
    // carries canonical target names instead, so MIMIC's own headers
    // (`gender`, `los`, `dod`, `hospital_expire_flag`) have to be MATCHED
    // rather than recognised.
    concept_pack   = "${projectDir}/assets/packs/clinical_core.yaml"

    // §3.1's rule list for this fixture. The SHIPPED default
    // (assets/blocking_rules.yaml) keys on birth_date/sex, a name prefix and
    // an MRN -- the identifiers a real registry linkage runs on, and none of
    // which a de-identified public fixture carries. Running it here would
    // report three rules at zero pairs and every record unblocked: a correct
    // report of a recall ceiling of zero, and no test of §3.2 or §3.3 at
    // all. assets/blocking_rules_fixture.yaml keys on what MIMIC-IV demo
    // actually has, and its own header says which of its rules is the easy
    // case and why that matters.
    blocking_rules = "${projectDir}/assets/blocking_rules_fixture.yaml"

    // §3.1's oversize guard, turned down from its 10000 default so that it
    // actually fires on this fixture. MIMIC-IV demo's labevents is an
    // EAV measurement table -- 107,727 rows over 100 subjects, a median of
    // 452 rows per subject and a maximum of 10,263 -- so blocking it on
    // subject_id yields blocks that are individually under the default
    // ceiling and collectively produce tens of millions of pairs.
    //
    // That is the correct behaviour of a badly chosen rule against a table
    // that is not "one row per patient-record" (§3.1's IN slot), and the
    // card's answer is to REPORT AND SKIP the oversize blocks rather than
    // silently expand them. At 200 the report shows exactly that happening,
    // with n_blocks_skipped_oversize and n_records_in_skipped_blocks naming
    // the recall it cost -- which is the number §3.1's Why says no later
    // stage can recover.
    max_block_size = 200

    // The shipped assets/comparisons.yaml is already written against this
    // fixture's columns (gender, anchor_year, marital_status, race,
    // language), so link_comparison_spec keeps its default here -- the
    // default being exercised is worth more than a second file.
}

process {
    // Same projection as conf/test.config: one number, visible in --help,
    // validated by nf-schema, and applied (§11.1).
    resourceLimits = [
        cpus: 4,
        memory: params.max_memory,
        time: '2.h'
    ]
}
