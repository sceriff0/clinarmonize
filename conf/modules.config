/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'PROFILE_COLUMNS' {
        publishDir = [
            path: { "${params.outdir}/profiles" },
            mode: params.publish_dir_mode,
            // The per-dataset *.failed.json is an intermediate the run-level
            // aggregator (workflows/harmonize.nf) reads and collates into the
            // single profiles/_failed.json the §2.3 contract names; only that
            // collated file (written directly, not via publishDir) belongs
            // in the published directory.
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.failed.json')) ? null : filename }
        ]
    }

    withName: 'MANIFEST_PROFILING_FAILURES' {
        publishDir = [
            path: { "${params.outdir}/profiles" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PERMUTE_OUTCOME' {
        // Nothing published. The permuted tables are test scaffolding, not
        // results -- 100 replicates x every dataset would bury results/
        // under copies of the input -- and everything the report needs from
        // them is already folded into tests/invariant/report.json.
        publishDir = [enabled: false]
    }

    withName: 'PROFILE_COLUMNS_PERMUTED' {
        // Same reasoning: results/profiles/ describes the data the run was
        // given. A permuted replicate's profile is an intermediate of the
        // §10.1 measurement and would collide, 100 times over, with the
        // baseline profile it is named after.
        publishDir = [enabled: false]
    }

    withName: 'INVARIANT_REPORT' {
        publishDir = [
            // The literal path §10.1's I/O slot names. Deliberately NOT
            // under params.outdir: the report is a statement about the
            // pipeline's code, not an output of any one run's data, and
            // every consumer named in the card (CI, the nf-test) looks for
            // it at this fixed path.
            path: { "${projectDir}/tests/invariant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
