/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'PROFILE_COLUMNS' {
        publishDir = [
            path: { "${params.outdir}/profiles" },
            mode: params.publish_dir_mode,
            // The per-dataset *.failed.json is an intermediate the run-level
            // aggregator (workflows/harmonize.nf) reads and collates into the
            // single profiles/_failed.json the §2.3 contract names; only that
            // collated file (written directly, not via publishDir) belongs
            // in the published directory.
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.failed.json')) ? null : filename }
        ]
    }

    withName: 'MANIFEST_PROFILING_FAILURES' {
        publishDir = [
            path: { "${params.outdir}/profiles" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PERMUTE_OUTCOME' {
        // Nothing published. The permuted tables are test scaffolding, not
        // results -- 100 replicates x every dataset would bury results/
        // under copies of the input -- and everything the report needs from
        // them is already folded into tests/invariant/report.json.
        publishDir = [enabled: false]
    }

    withName: 'PROFILE_COLUMNS_PERMUTED' {
        // Same reasoning: results/profiles/ describes the data the run was
        // given. A permuted replicate's profile is an intermediate of the
        // §10.1 measurement and would collide, 100 times over, with the
        // baseline profile it is named after.
        publishDir = [enabled: false]
    }

    withName: 'LINK_BLOCKING|LINK_SCORE|LINK_RESOLVE' {
        // The literal paths §3.1/§3.2/§3.3's OUT slots name -- 'link/...' is
        // already part of each process's own output declaration (the scripts
        // mkdir it), so the publishDir path is the bare outdir root, same
        // shape as COMPILE_RULES' 'rules/ruleset.json' below.
        //
        // link/match_histogram.png is published like everything else and is
        // NEVER conditional: §3.3's nogo is "never suppress the histogram
        // when the run looks clean", and a saveAs that dropped it on a
        // healthy run would be exactly that, one config line deep.
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAP_CONCEPTS' {
        // NOTHING is published here, and that is a change §6.2 forced rather
        // than a tidy-up. §6.1's mapped/ is an INTERMEDIATE now: CONVERT_UNITS
        // rewrites the same five tables plus _unmapped.parquet under the same
        // names, and two processes publishing into results/mapped/ would be
        // resolved by whichever finished last -- so results/ would carry
        // converted or unconverted values depending on task scheduling, which
        // is the worst possible way for a unit error to enter a dataset.
        //
        // The card's done-when for §6.1 (mapped/_unmapped.parquet exists even
        // when empty, every mapped row carries its source concept id) is still
        // satisfied by results/mapped/: CONVERT_UNITS copies _unmapped.parquet
        // through verbatim and rewrites the domain tables with `SELECT *
        // REPLACE`, so every column §6.1 wrote is still there.
        publishDir = [enabled: false]
    }

    withName: 'CONVERT_UNITS' {
        // The publisher of §6.2's own OUT slot's second artefact
        // (qc/unit_conversions.json), and NO LONGER of results/mapped/.
        //
        // §6.2 took mapped/ from MAP_CONCEPTS because it rewrote the same
        // five tables plus _unmapped.parquet under the same names; §6.3
        // (VALUE_MAP) now does the same to §6.2's output, so the publisher
        // moves on for the identical reason. Two publishDirs into
        // ${params.outdir}/mapped are resolved by whichever task finishes
        // last, and results/ would then carry value-mapped or unmapped rows
        // depending on task scheduling.
        //
        // This is a saveAs filter rather than `enabled: false` because
        // CONVERT_UNITS publishes TWO things and only one of them moved.
        // MAP_CONCEPTS could be switched off wholesale; this one cannot,
        // and a bare `enabled: false` here would delete
        // qc/unit_conversions.json from results/ -- §6.2's own OUT slot --
        // as a side effect of a §6.3 change.
        //
        // A run that fails the plausible-range post-condition still
        // publishes NOTHING from here, which is correct: the alternative is
        // a qc file describing a conversion whose output was never written.
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                (filename.equals('versions.yml') || filename.startsWith('mapped/')) ? null : filename
            }
        ]
    }

    withName: 'VALUE_MAP' {
        // The publisher of results/mapped/, and of §6.3's own OUT slot's
        // other two artefacts (qc/value_collapse.json, the alluvial PNGs).
        // Every path is already part of the process's output declaration, so
        // this is the bare outdir root -- the same shape CONVERT_UNITS used
        // while it was the last writer of mapped/.
        //
        // qc/alluvial_*.png is published like everything else and is NEVER
        // conditional here: §6.3's nogo is "Never suppress the alluvial plot
        // because the collapse looked obvious", and a saveAs that dropped it
        // on a run whose collapses looked small would be exactly that, one
        // config line deep. The only thing that suppresses it is
        // --emit_alluvial, and bin/value_map.py records that on every qc
        // entry when it happens.
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LINK_BLOCKING_PERMUTED|LINK_SCORE_PERMUTED|LINK_RESOLVE_PERMUTED|MAP_CONCEPTS_PERMUTED|CONVERT_UNITS_PERMUTED|VALUE_MAP_PERMUTED' {
        // ADR-004's map-scoped replicates. Same reasoning as
        // PROFILE_COLUMNS_PERMUTED above, and it matters more here: results/
        // link/ and results/mapped/ describe the data the run was actually
        // given, and 100 replicates' worth of permuted links.parquet and
        // measurement.parquet would overwrite them one after another with
        // tables nobody asked for. Everything the harness needs from these
        // tasks is already folded into tests/invariant/report.json.
        //
        // Declared AFTER the LINK_*/MAP_CONCEPTS block above so that, under
        // whichever matching semantics a given Nextflow release uses for
        // withName selectors, the LAST matching rule is the one that
        // disables publishing rather than the one that enables it.
        publishDir = [enabled: false]
    }

    withName: 'ARTEFACT_DIGEST' {
        // Nothing published. The digest is not a result of the run's data --
        // it is the reduction the §10.1 report compares replicates by -- and
        // every digest, baseline included, is written into
        // tests/invariant/report.json verbatim (ledger_hashes /
        // mapped_hashes / composite_hashes). A second copy under results/
        // would be a file that can go stale against the report.
        publishDir = [enabled: false]
    }

    withName: 'PROPOSE_CANDIDATES' {
        publishDir = [
            path: { "${params.outdir}/propose" },
            mode: params.publish_dir_mode,
            // Only the baseline replicate's candidates.parquet is a result
            // of the data this run was given -- the literal path §4.1's OUT
            // slot names. A harness replicate's candidates.p<seed>.parquet
            // is test scaffolding for §10.1, same reasoning as
            // PROFILE_COLUMNS_PERMUTED just above: 100 of them would bury
            // results/ under copies nobody asked for.
            saveAs: { filename -> (filename.equals('versions.yml') || filename ==~ /candidates\.p\d+\.parquet/) ? null : filename }
        ]
    }

    withName: 'PROPOSE_CHANNELS' {
        publishDir = [
            path: { "${params.outdir}/propose" },
            mode: params.publish_dir_mode,
            // Same policy as PROPOSE_CANDIDATES immediately above: only the
            // baseline replicate's evidence.parquet and confirmation_plots/
            // are a result of the data this run was given. A harness
            // replicate's evidence.p<seed>.parquet and
            // confirmation_plots.p<seed>/ are §10.1 test scaffolding -- 100
            // of them would bury results/ under copies nobody asked for.
            saveAs: { filename -> (filename.equals('versions.yml') || filename ==~ /evidence\.p\d+\.parquet/ || filename ==~ /confirmation_plots\.p\d+/) ? null : filename }
        ]
    }

    withName: 'PROPOSE_LEDGER' {
        publishDir = [
            // The literal path §4.3's I/O slot names -- 'ledger.proposed.yaml',
            // with NO 'propose/' prefix, unlike PROPOSE_CANDIDATES /
            // PROPOSE_CHANNELS immediately above (s4-1/s4-2's OUT slots both
            // carry one). Ruling R13: this is the path a plain or single-seed
            // run's own done-when sha256sums, so it has to sit directly under
            // outdir, not under outdir/propose.
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            // Same policy as PROPOSE_CANDIDATES / PROPOSE_CHANNELS: only the
            // baseline replicate's ledger is a result of the data this run
            // was given. A harness replicate's ledger.proposed.p<seed>.yaml
            // is §10.1 test scaffolding, hashed in Groovy straight off the
            // channel -- never published.
            saveAs: { filename -> (filename.equals('versions.yml') || filename ==~ /ledger\.proposed\.p\d+\.yaml/) ? null : filename }
        ]
    }

    withName: 'COMPILE_RULES' {
        publishDir = [
            // The literal path §5.2's I/O slot names -- 'rules/ruleset.json'
            // (the 'rules/' prefix is already part of the process's own
            // output declaration, unlike PROPOSE_CANDIDATES/PROPOSE_CHANNELS'
            // 'propose/' prefix, which lives here instead) -- so the
            // publishDir path itself is the bare outdir root, same reasoning
            // as PROPOSE_LEDGER's own override immediately above it.
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'INVARIANT_REPORT' {
        publishDir = [
            // The literal path §10.1's I/O slot names. Deliberately NOT
            // under params.outdir: the report is a statement about the
            // pipeline's code, not an output of any one run's data, and
            // every consumer named in the card (CI, the nf-test) looks for
            // it at this fixed path.
            path: { "${projectDir}/tests/invariant" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
